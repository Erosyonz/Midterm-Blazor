@page "/"
@inject TourService Tours
<PageTitle>WanderNest | Discover Cordova, Cebu</PageTitle>

@* Homepage redesigned to follow the reference layout while reusing the existing wandernest.css classes and color palette. *@
<section class="hero wander-hero">
    <div class="hero-shade"></div>
    <div class="hero-content wrap wander-hero-content" style="text-align:center;">
        <span class="eyebrow light-eyebrow"><span class="eyebrow-dot"></span> WANDERNEST · CORDOVA, CEBU</span>
        <h1 style="margin-left:auto;margin-right:auto;max-width:850px;font-size:clamp(54px,8vw,96px);">Travel</h1>
        <p style="margin-left:auto;margin-right:auto;max-width:480px;">Travel with intention. Discover coastal escapes, local adventures, and memorable stays around Cordova and Cebu.</p>
        <div class="hero-actions" style="justify-content:center;">
            <a class="btn btn-primary" href="/products">Explore destinations <span>↗</span></a>
            <a class="btn btn-glass" href="/contact">Plan your trip</a>
        </div>
    </div>
</section>

<section class="trust-strip">
    <div class="wrap trust-items">
        <span><b>✦</b> Local experiences</span>
        <span><b>★</b> Cordova and Cebu escapes</span>
        <span><b>⌁</b> Trips at your own pace</span>
    </div>
</section>

<section class="section wrap">
    <div class="section-heading" style="align-items:center;justify-content:center;text-align:center;">
        <div>
            <span class="eyebrow">A LITTLE CLOSER TO PARADISE</span>
            <h2 style="font-size:clamp(38px,5.5vw,58px);">WanderNest means<br />going <em>places.</em></h2>
        </div>
    </div>

    <div class="why-section" style="margin-top:45px;">
        <div class="why-copy">
            <span class="eyebrow">OUR VALUE</span>
            <h2 style="font-size:clamp(30px,3.5vw,42px);">Not your boring<br /><em>travel planner.</em></h2>
            <p>We bring together local coastal spots, nature escapes, and nearby Cebu adventures so you can spend less time planning and more time enjoying the journey.</p>
            <a class="btn btn-dark" href="/products">Find your getaway <span>↗</span></a>
        </div>
        <div class="destination-grid" style="grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;">
            @foreach (var destination in Tours.GetDestinations().Take(2))
            {
                <article class="destination-card">
                    <div class="card-image" style="height:235px;">
                        <img src="@destination.ImageUrl" alt="@destination.Name" loading="lazy" />
                        <span class="image-tag">@destination.Category</span>
                    </div>
                    <div class="card-body">
                        <p class="card-location">⌖ @destination.Region</p>
                        <h3>@destination.Name</h3>
                        <p class="card-description">@destination.Description</p>
                        <a class="card-link" href="/products">Explore place <span>→</span></a>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="package-section">
    <div class="wrap">
        <div class="section-heading">
            <div>
                <span class="eyebrow">POPULAR DESTINATIONS</span>
                <h2>Pick the <em>place.</em></h2>
            </div>
            <p class="section-intro" style="max-width:330px;margin:0;">From peaceful coastlines to outdoor adventures, find an experience that fits your kind of getaway.</p>
        </div>

        @* Visual search/filter bar; destination filtering can be connected when the backend is implemented. *@
        <div class="filter-panel" style="margin-top:28px;margin-bottom:26px;padding:18px;">
            <div class="filter-grid" style="grid-template-columns:1.4fr 1fr 1fr 1fr auto;align-items:end;">
                <label class="filter-field">Destination<input type="text" placeholder="Find a spot..." /></label>
                <label class="filter-field">Category<select><option>All experiences</option><option>Nature</option><option>Coastal</option><option>Adventure</option></select></label>
                <label class="filter-field">Budget<select><option>Any budget</option><option>Under ₱1,000</option><option>₱1,000–₱3,000</option></select></label>
                <label class="filter-field">Date<input type="text" placeholder="Choose a date" onfocus="(this.type='date')" onblur="if(!this.value)this.type='text'" /></label>
                <a class="btn btn-dark" href="/products">Discover</a>
            </div>
        </div>

        <div class="destination-grid">
            @foreach (var destination in Tours.GetDestinations().Take(3))
            {
                <article class="destination-card">
                    <div class="card-image">
                        <img src="@destination.ImageUrl" alt="@destination.Name" loading="lazy" />
                        <span class="image-tag">@destination.Category</span>
                    </div>
                    <div class="card-body">
                        <p class="card-location">@destination.Region</p>
                        <h3>@destination.Name</h3>
                        <p class="card-description">@destination.Description</p>
                        <div class="card-meta">
                            <span class="rating">★ @destination.Rating.ToString("0.0") <small>sample</small></span>
                            <span class="price">From <strong>₱@destination.StartingPrice.ToString("N0")</strong></span>
                        </div>
                        <a class="card-link" href="/products">View destination <span>→</span></a>
                    </div>
                </article>
            }
        </div>
        <p class="fine-print">Ratings and prices are illustrative demo content. Images are representative and may not depict the exact listed location.</p>
    </div>
</section>

<section class="section wrap">
    <div class="section-heading">
        <div>
            <span class="eyebrow">MADE FOR YOUR KIND OF GETAWAY</span>
            <h2>Find your next <em>escape.</em></h2>
        </div>
        <a class="text-link" href="/products">View all trips <span>↗</span></a>
    </div>
    <div class="package-grid">
        @foreach (var pack in Tours.GetPackages().Take(3))
        {
            <article class="package-card">
                <img src="@pack.ImageUrl" alt="@pack.Name" loading="lazy" />
                <div class="package-content">
                    <span class="package-kicker">@pack.Category · @pack.DurationDays day(s)</span>
                    <h3>@pack.Name</h3>
                    <p>@pack.Description</p>
                    <div class="package-bottom">
                        <span>From <strong>₱@pack.PricePerPerson.ToString("N0")</strong><small>/ person · sample price</small></span>
                        <a href="/products" aria-label="View @pack.Name">↗</a>
                    </div>
                </div>
            </article>
        }
    </div>
</section>

<section class="closing-cta">
    <div class="wrap closing-inner">
        <div>
            <span class="eyebrow light-eyebrow">YOUR NEXT CEBU ADVENTURE</span>
            <h2>Ready to go <em>somewhere?</em></h2>
            <p>Explore Cordova, discover nearby Cebu destinations, and start planning your next memorable getaway.</p>
        </div>
        <div class="closing-actions">
            <a class="btn btn-white" href="/products">Explore destinations ↗</a>
            <a class="btn btn-glass" href="/contact">Contact us</a>
        </div>
    </div>
</section>
